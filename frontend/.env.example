# Copy this file to .env.local and replace values
# PowerShell: Copy-Item .env.example .env.local

# Gemini API key used by Smart Bid Advisor frontend module
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: switch model if needed
VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional: if you move to a backend proxy later
# VITE_SMART_BID_ADVISOR_PROXY_URL=http://localhost:8080/api/ai/bidadvisor
